// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CLIENT)
  accounts      Account[]
  sessions      Session[]

  // Coach-specific fields
  coachProfile CoachProfile?

  // Client-specific fields
  clientProfile ClientProfile?

  // Optional provenance — a user can originate from at most one lead
  originLead Lead? @relation(name: "LeadToUser")
}

model Lead {
  id                  String         @id @default(cuid())
  // Basic contact info submitted by the lead
  name                String
  email               String
  phone               String?
  // The coach this lead is interested in working with (required)
  coachId             String
  coach               CoachProfile   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  // Raw intake form submission (JSON, structure set by CoachProfile.intakeFormSchema)
  intakeSubmission    Json?
  intakeSchemaId      String?
  intakeSchemaVersion Int?
  // Status of the lead through the funnel
  status              LeadStatus     @default(PENDING)
  // Conversion targets (optional) — enforce at most one lead per user/client
  userId              String?        @unique
  user                User?          @relation(name: "LeadToUser", fields: [userId], references: [id], onDelete: SetNull)
  clientProfileId     String?        @unique
  clientProfile       ClientProfile? @relation(name: "LeadToClientProfile", fields: [clientProfileId], references: [id], onDelete: SetNull)
  orders              Order[]
  coachingRelationshipId String? @unique
  coachingRelationship CoachingRelationship? @relation("LeadToCoachingRelationship", fields: [coachingRelationshipId], references: [id], onDelete: SetNull)

  // Time tracking
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?
  acceptedAt DateTime?
}

enum LeadStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
  CONVERTED
}

enum UserRole {
  CLIENT
  COACH
  ADMIN
}

model CoachProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                     String?
  specialties             String[] // e.g., ["Weight Loss", "Muscle Building"]
  socialMediaLinks        Json? // Store Instagram, TikTok, YouTube links
  // JSON schema describing the intake form fields a client should fill
  intakeFormSchema        Json?
  intakeFormSchemaId      String?
  intakeFormSchemaVersion Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  publicSlug  String? @unique
  headline    String?
  heroImage   String? // URL
  programs Program[]
  products Product[]
  orders   Order[]

  leads    Lead[]
  coachingRelationships CoachingRelationship[]
}

model ClientProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Required basic contact info
  name         String
  email        String
  // Optional additional contact options
  phone        String?
  // High-level goals
  goals        String[] @default([]) // e.g., ["Lose weight", "Build muscle"]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments Enrollment[]
  orders      Order[]

  // Optional provenance — a client profile can originate from at most one lead
  originLead Lead? @relation(name: "LeadToClientProfile")
  
  coachingRelationships CoachingRelationship[]
}

model Program {
  id          String       @id @default(cuid())
  name        String
  description String
  coachId     String
  coach       CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  price       Float // Monthly price
  duration    Int // Duration in weeks
  maxClients  Int? // Maximum cohort size
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  enrollments Enrollment[]

  @@index([coachId])
}

model Enrollment {
  id        String           @id @default(cuid())
  clientId  String
  client    ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  programId String
  program   Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  status    EnrollmentStatus @default(ACTIVE)
  startDate DateTime         @default(now())
  endDate   DateTime?
  createdAt DateTime         @default(now())

  @@unique([clientId, programId])
  @@index([clientId])
  @@index([programId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProductType {
  ONE_OFF
  RECURRING
}

enum OrderStatus {
  INITIATED
  PENDING_PAYMENT
  PAID
  REFUNDED
  CANCELED
}

model Product {
  id              String       @id @default(cuid())
  coachId         String
  coach           CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  priceCents      Int
  currency        String
  type            ProductType  @default(ONE_OFF)
  isActive        Boolean      @default(true)
  stripeProductId String?
  stripePriceId   String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orders Order[]

  @@index([coachId, isActive])
}

model Order {
  id                      String         @id @default(cuid())
  coachId                 String
  coach                   CoachProfile   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  productId               String
  product                 Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  leadId                  String?
  lead                    Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId                String?
  client                  ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  amountCents             Int
  currency                String
  status                  OrderStatus    @default(INITIATED)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeInvoiceId         String?
  metadata                Json?
  fulfilledAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([coachId])
  @@index([productId])
  @@index([leadId])
  @@index([clientId])
  @@index([status])
}

enum CoachingRelationshipStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  PAUSED
}

model CoachingRelationship {
  id                    String                        @id @default(cuid())
  coachId               String
  coach                 CoachProfile                  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clientId              String
  client                ClientProfile                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status                CoachingRelationshipStatus    @default(ACTIVE)
  // Intake form data from lead conversion
  intakeSubmission      Json?
  intakeSchemaId        String?
  intakeSchemaVersion   Int?
  startDate             DateTime                      @default(now())
  endDate               DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  // Optional link back to the lead that created this relationship
  originLead Lead? @relation("LeadToCoachingRelationship")

  @@unique([coachId, clientId])
  @@index([coachId])
  @@index([clientId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
