// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    role          UserRole  @default(CLIENT)
    accounts      Account[]
    sessions      Session[]
    
    // Coach-specific fields
    coachProfile  CoachProfile?
    
    // Client-specific fields
    clientProfile ClientProfile?
}

enum UserRole {
    CLIENT
    COACH
    ADMIN
}

model CoachProfile {
    id               String   @id @default(cuid())
    userId           String   @unique
    user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    bio              String?
    specialties      String[] // e.g., ["Weight Loss", "Muscle Building"]
    socialMediaLinks Json?    // Store Instagram, TikTok, YouTube links
    // JSON schema describing the intake form fields a client should fill
    intakeFormSchema Json?
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt
    
    programs         Program[]
}

model ClientProfile {
    id          String       @id @default(cuid())
    userId      String       @unique
    user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    // Required basic contact info
    name        String
    email       String
    // Optional additional contact options
    phone       String?
    // Coach-defined dynamic fields captured from custom intake form
    customFields Json?
    // High-level goals
    goals       String[]     @default([]) // e.g., ["Lose weight", "Build muscle"]
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    
    enrollments Enrollment[]
    workoutLogs WorkoutLog[]
}

model Program {
    id           String       @id @default(cuid())
    name         String
    description  String
    coachId      String
    coach        CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
    price        Float        // Monthly price
    duration     Int          // Duration in weeks
    maxClients   Int?         // Maximum cohort size
    isActive     Boolean      @default(true)
    createdAt    DateTime     @default(now())
    updatedAt    DateTime     @updatedAt
    
    enrollments  Enrollment[]
    workouts     Workout[]
    
    @@index([coachId])
}

model Enrollment {
    id          String        @id @default(cuid())
    clientId    String
    client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
    programId   String
    program     Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
    status      EnrollmentStatus @default(ACTIVE)
    startDate   DateTime      @default(now())
    endDate     DateTime?
    createdAt   DateTime      @default(now())
    
    @@unique([clientId, programId])
    @@index([clientId])
    @@index([programId])
}

enum EnrollmentStatus {
    ACTIVE
    COMPLETED
    CANCELLED
}

model Workout {
    id          String   @id @default(cuid())
    name        String
    description String?
    programId   String
    program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
    weekNumber  Int      // Which week of the program
    dayNumber   Int      // Which day of the week
    exercises   Json     // Array of exercises with sets, reps, etc.
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    
    workoutLogs WorkoutLog[]
    
    @@index([programId])
}

model WorkoutLog {
    id          String        @id @default(cuid())
    clientId    String
    client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
    workoutId   String
    workout     Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
    completed   Boolean       @default(false)
    notes       String?
    performance Json?         // Actual weights, reps performed, etc.
    date        DateTime      @default(now())
    createdAt   DateTime      @default(now())
    
    @@index([clientId])
    @@index([workoutId])
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}
